# Copy to .env and fill in. Only VITE_* variables reach the browser.

# Google Analytics 4 measurement ID (optional; analytics is skipped when unset)
VITE_LOVABLE_CONNECTOR_GOOGLE_ANALYTICS_API_KEY=

# Public site origin, used for canonical URLs, og:url and sitemap.xml
VITE_SITE_URL=https://www.thrivepainwellness.in
